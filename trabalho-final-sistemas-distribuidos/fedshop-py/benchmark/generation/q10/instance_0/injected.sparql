SELECT DISTINCT ?offer ?price {
FILTER("3"^^<http://www.w3.org/2001/XMLSchema#integer> <= "3"^^<http://www.w3.org/2001/XMLSchema#integer> && ?date > "1971-09-30"^^<http://www.w3.org/2001/XMLSchema#date>)
<http://www.vendor2.fr/Vendor0> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/country> <http://downlode.org/rdf/iso-3166/countries#US>.
?offer <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/deliveryDays> "3"^^<http://www.w3.org/2001/XMLSchema#integer>.
?offer <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/product> <http://www.vendor2.fr/Product12614>.
?offer <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/vendor> <http://www.vendor2.fr/Vendor0>.
?offer <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/price> ?price.
?offer <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/validTo> ?date.
}
ORDER BY <http://www.w3.org/2001/XMLSchema#double>(STR(?price)) 
OFFSET 0 LIMIT 10
