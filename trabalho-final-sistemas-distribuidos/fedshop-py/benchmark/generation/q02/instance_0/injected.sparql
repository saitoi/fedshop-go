SELECT DISTINCT ?label ?comment ?producer ?propertyTextual1 ?propertyTextual4 {
?localProduct <http://www.w3.org/2002/07/owl#sameAs> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/Product8987>.
?localProduct <http://www.w3.org/2000/01/rdf-schema#label> ?label.
?localProduct <http://www.w3.org/2000/01/rdf-schema#comment> ?comment.
?localProduct <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/producer> ?p.
?p <http://www.w3.org/2000/01/rdf-schema#label> ?producer.
OPTIONAL{
?localProduct <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/productPropertyTextual1> ?propertyTextual1.
}
OPTIONAL{
?localProduct <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/productPropertyTextual4> ?propertyTextual4.
}
}
LIMIT 10
